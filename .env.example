APP_NAME=LOJMAN Yönetim Sistemi
APP_VERSION=0.1.0
APP_ENV=development

# SSMS'te LOJMANDB'ye bağlanırken kullanılan yerel SQL Server.
SQL_SERVER=.
SQL_DATABASE=LOJMANDB

# Boş bırakılırsa uygulama önce ODBC Driver 18'i, sonra 17'yi arar.
SQL_DRIVER=
SQL_ENCRYPT=true
SQL_TRUST_SERVER_CERTIFICATE=true
SQL_CONNECTION_TIMEOUT=5
SQL_POOL_SIZE=5
SQL_MAX_OVERFLOW=10

# 01_Kurulum.bat bu alanı güvenli ve rastgele bir değerle oluşturur.
SESSION_SECRET=KURULUM_TARAFINDAN_OLUSTURULACAK
SESSION_HTTPS_ONLY=false

# TERS VEKIL ARKASINDA GERCEK IP
# Uygulamanin onunde IIS ya da nginx varsa o sunucunun adresini
# yazin; yalnizca oradan gelen X-Forwarded-For basligi dikkate
# alinir.
#
# BOS BIRAKMAK GUVENLI: baslik hic okunmaz. Doldurulmazsa ve
# uygulama vekil arkasindaysa IP bazli hiz siniri islevsiz kalir
# (herkes ayni IP'den geliyor gorunur).
GUVENILIR_VEKILLER=

# DIS AKTARIM PAROLA ANAHTARI
# Uyumsoft gibi bir dis veritabanina baglanirken kullanilan
# parolalar bununla sifrelenir. Rastgele ve uzun bir metin olsun.
#
# DEGISTIRMEYIN: degisirse kayitli parolalar cozulemez ve yeniden
# girilmesi gerekir.
AKTARIM_ANAHTARI=

# Ana ekrandaki bolgesel hava durumu.
# Bicim: Ad,enlem,boylam;Ad,enlem,boylam;...
# Tesis eklemek veya cikarmak icin bu satiri duzenleyin.
# Kapatmak icin HAVA_AKTIF=false yapin; ekran eski tanitim metnine doner.
HAVA_AKTIF=true
HAVA_KONUMLAR=Fethiye,36.6213,29.1164;Kuşadası,37.8600,27.2597;Lara,36.8556,30.7889

# Her sayfanin altindaki serit metni.
APP_ALT_SERIT=AND360° Lojman Yönetim Sistemi - Ver.01.Abd@And.31.07.2026

# Sorgu zaman asimi (saniye). Yavas sorgu sayfayi askida
# birakmak yerine hata versin.
SQL_QUERY_TIMEOUT=30

APP_HOST=127.0.0.1
APP_PORT=8000
APP_RELOAD=true
